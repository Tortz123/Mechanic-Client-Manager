# Copy this file to .env and fill in real values for local development.
# .env is gitignored; never commit real secrets.

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mechanic_client_manager

# Used to sign the session cookie. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Port the server listens on (Render sets this automatically in production)
PORT=3000

# development | production | test
NODE_ENV=development
